### ============================================================
### Member Profile Image + S3 Scenario
###
### 검증 흐름
###
### 1. 로그인
### 2. 현재 회원 조회
### 3. Presigned PUT URL 발급
### 4. S3 직접 업로드
### 5. 프로필 이미지 적용
### 6. 회원 조회 및 profileImageUrl 확인
### 7. Presigned GET URL로 실제 이미지 조회
### 8. 두 번째 Presigned PUT URL 발급
### 9. 두 번째 이미지 업로드
### 10. 프로필 이미지 교체
### 11. 회원 조회
### 12. 프로필 이미지 삭제
### 13. 회원 조회 및 profileImageUrl=null 확인
### ============================================================


@baseUrl = http://localhost:8080
@contentType = application/json

### ------------------------------------------------------------
### 테스트 계정
###
### 현재 DB에 존재하는 ACTIVE 회원으로 변경
### ------------------------------------------------------------

@email = admin@test.com
@password = Admin1234!


### ============================================================
### 1. 로그인
### ============================================================

# @name signIn
POST {{baseUrl}}/api/v1/auth/sign-in
Content-Type: {{contentType}}

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
  client.test("로그인 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.accessToken,
      "accessToken이 없습니다."
  );

  client.global.set(
      "accessToken",
      response.body.accessToken
  );
%}


### ============================================================
### 2. 현재 회원 조회
### ============================================================

# @name getMeBeforeProfileImage
GET {{baseUrl}}/api/v1/members/me
Authorization: Bearer {{accessToken}}

> {%
  client.test("내 정보 조회 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.memberId,
      "memberId가 없습니다."
  );

  client.global.set(
      "memberId",
      response.body.memberId
  );
%}


### ============================================================
### 3. 첫 번째 프로필 이미지 Presigned PUT URL 발급
### ============================================================

# @name createFirstProfileUploadUrl
POST {{baseUrl}}/api/v1/members/me/profile-image/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "contentType": "image/webp"
}

> {%
  client.test("첫 번째 Presigned URL 발급 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.objectKey,
      "objectKey가 없습니다."
  );

  client.assert(
      response.body.uploadUrl,
      "uploadUrl이 없습니다."
  );

  client.assert(
      response.body.expiresAt,
      "expiresAt이 없습니다."
  );

  client.global.set(
      "firstProfileImageKey",
      response.body.objectKey
  );

  client.global.set(
      "firstProfileUploadUrl",
      response.body.uploadUrl
  );
%}


### ============================================================
### 4. 첫 번째 이미지 S3 직접 업로드
###
### 중요:
### Authorization Bearer 헤더를 넣지 않는다.
###
### URL 발급 시 image/webp로 서명했으므로
### 실제 PUT도 Content-Type: image/webp 이어야 한다.
### ============================================================

# @name uploadFirstProfileImage
PUT {{firstProfileUploadUrl}}
Content-Type: image/webp

< ./files/profile-test.webp

> {%
  client.test("첫 번째 S3 업로드 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });
%}


### ============================================================
### 5. 첫 번째 프로필 이미지 적용
### ============================================================

# @name applyFirstProfileImage
PATCH {{baseUrl}}/api/v1/members/me/profile-image
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "objectKey": "{{firstProfileImageKey}}"
}

> {%
  client.test("첫 번째 프로필 이미지 적용 성공", function () {
    client.assert(
        response.status === 204,
        "Expected 204 but got " + response.status
    );
  });
%}


### ============================================================
### 6. 회원 조회
###
### profileImageUrl이 생성되어 있어야 한다.
### ============================================================

# @name getMeAfterFirstProfileImage
GET {{baseUrl}}/api/v1/members/me
Authorization: Bearer {{accessToken}}

> {%
  client.test("프로필 이미지 적용 후 회원 조회 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.profileImageUrl,
      "profileImageUrl이 없습니다."
  );

  client.global.set(
      "firstProfileImageReadUrl",
      response.body.profileImageUrl
  );
%}


### ============================================================
### 7. Presigned GET URL 실제 조회
###
### 200 + image/webp 응답이면 성공
### ============================================================

# @name readFirstProfileImage
GET {{firstProfileImageReadUrl}}

> {%
  client.test("첫 번째 프로필 이미지 조회 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });
%}


### ============================================================
### 8. 두 번째 프로필 이미지 Presigned PUT URL 발급
###
### 이미지 교체 테스트
### ============================================================

# @name createSecondProfileUploadUrl
POST {{baseUrl}}/api/v1/members/me/profile-image/upload-url
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "contentType": "image/webp"
}

> {%
  client.test("두 번째 Presigned URL 발급 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.objectKey,
      "두 번째 objectKey가 없습니다."
  );

  client.assert(
      response.body.uploadUrl,
      "두 번째 uploadUrl이 없습니다."
  );

  client.assert(
      response.body.objectKey !==
      client.global.get("firstProfileImageKey"),
      "첫 번째와 두 번째 objectKey가 같습니다."
  );

  client.global.set(
      "secondProfileImageKey",
      response.body.objectKey
  );

  client.global.set(
      "secondProfileUploadUrl",
      response.body.uploadUrl
  );
%}


### ============================================================
### 9. 두 번째 이미지 S3 업로드
###
### 같은 테스트 파일을 사용해도 된다.
### objectKey가 UUID 기반이므로 서로 다른 S3 Object가 생성된다.
### ============================================================

# @name uploadSecondProfileImage
PUT {{secondProfileUploadUrl}}
Content-Type: image/webp

< ./files/profile-test.webp

> {%
  client.test("두 번째 S3 업로드 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });
%}


### ============================================================
### 10. 두 번째 프로필 이미지 적용
###
### 여기서:
###
### DB
### first key -> second key
###
### AFTER_COMMIT
### first S3 object 삭제
###
### 가 발생해야 한다.
### ============================================================

# @name replaceProfileImage
PATCH {{baseUrl}}/api/v1/members/me/profile-image
Authorization: Bearer {{accessToken}}
Content-Type: {{contentType}}

{
  "objectKey": "{{secondProfileImageKey}}"
}

> {%
  client.test("프로필 이미지 교체 성공", function () {
    client.assert(
        response.status === 204,
        "Expected 204 but got " + response.status
    );
  });
%}


### ============================================================
### 11. 회원 조회
###
### 새로운 profileImageUrl이 반환되어야 한다.
### ============================================================

# @name getMeAfterReplaceProfileImage
GET {{baseUrl}}/api/v1/members/me
Authorization: Bearer {{accessToken}}

> {%
  client.test("프로필 이미지 교체 후 회원 조회 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.profileImageUrl,
      "교체 후 profileImageUrl이 없습니다."
  );

  client.global.set(
      "secondProfileImageReadUrl",
      response.body.profileImageUrl
  );
%}


### ============================================================
### 12. 두 번째 프로필 이미지 실제 조회
### ============================================================

# @name readSecondProfileImage
GET {{secondProfileImageReadUrl}}

> {%
  client.test("교체된 프로필 이미지 조회 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });
%}


### ============================================================
### 13. 프로필 이미지 삭제
###
### DB profile_image_key -> NULL
###
### commit 성공 후
### AFTER_COMMIT listener -> S3 Object 삭제
### ============================================================

# @name deleteProfileImage
DELETE {{baseUrl}}/api/v1/members/me/profile-image
Authorization: Bearer {{accessToken}}

> {%
  client.test("프로필 이미지 삭제 성공", function () {
    client.assert(
        response.status === 204,
        "Expected 204 but got " + response.status
    );
  });
%}


### ============================================================
### 14. 삭제 후 회원 조회
###
### profileImageUrl == null 이어야 한다.
### ============================================================

# @name getMeAfterDeleteProfileImage
GET {{baseUrl}}/api/v1/members/me
Authorization: Bearer {{accessToken}}

> {%
  client.test("프로필 이미지 삭제 후 회원 조회 성공", function () {
    client.assert(
        response.status === 200,
        "Expected 200 but got " + response.status
    );
  });

  client.assert(
      response.body.profileImageUrl === null,
      "profileImageUrl이 null이 아닙니다."
  );
%}


### ============================================================
### 15. [선택] 삭제된 두 번째 Presigned GET URL 재조회
###
### 주의:
### 이 요청은 의도적으로 실패해야 한다.
###
### 기존 URL의 서명 유효기간이 남아 있어도
### S3 Object 자체가 삭제됐으므로 404가 정상이다.
### ============================================================

# @name verifyDeletedSecondProfileImage
GET {{secondProfileImageReadUrl}}

> {%
  client.test("삭제된 S3 Object 조회 실패 확인", function () {
    client.assert(
        response.status === 404,
        "Expected 404 but got " + response.status
    );
  });
%}
