Content-Type: {{contentType}}

{
  "status": "SOLD_OUT"
}


###############################################################################
# 67. 공연 회차 상태 OPEN 복구
###############################################################################
PATCH {{baseUrl}}/api/v1/admin/performances/{{performanceId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "status": "OPEN"
}


###############################################################################
# 68. 공연 회차 상태 COMPLETED 변경
### COMPLETED는 최종 상태
###############################################################################
PATCH {{baseUrl}}/api/v1/admin/performances/{{performanceId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "status": "COMPLETED"
}


###############################################################################
# 69. 공연 상태 CLOSED 변경
### PUBLISHED -> CLOSED, CLOSED는 최종 상태
###############################################################################
PATCH {{baseUrl}}/api/v1/admin/concerts/{{concertId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "status": "CLOSED"
}


