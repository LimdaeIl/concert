###############################################################################
# 73. 관리자 Access Token 재발급
### 주의: HTTP Client cookie jar의 Refresh Token은 가장 최근 로그인 계정 기준일 수 있음.
### 관리자 Refresh Token으로 재발급을 검증하려면 1번 직후 실행하는 것이 가장 명확함.
###############################################################################
POST {{baseUrl}}/api/v1/auth/reissue

> {%
    client.global.set("reissuedAccessToken", response.body.data.accessToken);
%}


