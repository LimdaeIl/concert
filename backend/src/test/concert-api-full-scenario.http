# 54. 관리자 결제 환불
###############################################################################
POST {{baseUrl}}/api/v1/admin/payments/{{paymentId2}}/refund
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "reason": "HTTP 시나리오 관리자 환불 테스트",
  "providerData": {
    "paymentKey": "TEST_PAYMENT_KEY_2",
    "orderId": "{{paymentNumber2}}"
  }
}


