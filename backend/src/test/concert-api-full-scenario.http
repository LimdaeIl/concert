POST {{baseUrl}}/api/v1/auth/phone-verifications/verify
Content-Type: {{contentType}}

{
  "phone": "{{changedMemberPhone}}",
  "verificationCode": "{{changedPhoneVerificationCode}}"
}

> {%
    client.global.set("changedPhoneVerificationToken", response.body.data.verificationToken);
%}


###############################################################################
# 57. 휴대전화번호 변경
### 성공 시 Refresh Token 폐기 → 다음 단계에서 다시 로그인
###############################################################################
PATCH {{baseUrl}}/api/v1/members/me/phone
Authorization: Bearer {{memberAccessToken}}
Content-Type: {{contentType}}

{
  "phone": "{{changedMemberPhone}}",
  "phoneVerificationToken": "{{changedPhoneVerificationToken}}"
}


###############################################################################
# 58. 휴대전화번호 변경 후 재로그인
###############################################################################
POST {{baseUrl}}/api/v1/auth/sign-in
Content-Type: {{contentType}}

{
  "email": "{{memberEmail}}",
  "password": "{{memberPassword}}"
}

> {%
    client.global.set("memberAccessToken", response.body.data.accessToken);
%}


###############################################################################
# 59. 변경할 이메일 인증번호 발송
###############################################################################
POST {{baseUrl}}/api/v1/auth/email-verifications
Content-Type: {{contentType}}

{
  "email": "{{changedMemberEmail}}"
}


###############################################################################
# 60. 변경할 이메일 인증번호 검증
###############################################################################
POST {{baseUrl}}/api/v1/auth/email-verifications/verify
Content-Type: {{contentType}}

{
  "email": "{{changedMemberEmail}}",
  "verificationCode": "{{changedEmailVerificationCode}}"
}

> {%
    client.global.set("changedEmailVerificationToken", response.body.data.verificationToken);
%}


###############################################################################
# 61. 이메일 변경
### 성공 시 Refresh Token 폐기 → 다음 단계에서 변경된 이메일로 다시 로그인
###############################################################################
PATCH {{baseUrl}}/api/v1/members/me/email
Authorization: Bearer {{memberAccessToken}}
Content-Type: {{contentType}}

{
  "email": "{{changedMemberEmail}}",
  "emailVerificationToken": "{{changedEmailVerificationToken}}"
}


###############################################################################
# 62. 이메일 변경 후 재로그인
###############################################################################
POST {{baseUrl}}/api/v1/auth/sign-in
Content-Type: {{contentType}}

{
  "email": "{{changedMemberEmail}}",
  "password": "{{memberPassword}}"
}

> {%
    client.global.set("memberAccessToken", response.body.data.accessToken);
%}


###############################################################################
# 63. 비밀번호 변경
### Swagger 원문에서 이 엔드포인트의 Request Body Schema가 노출되지 않음.
### 아래 body 필드명은 실제 구현 DTO와 반드시 맞춘 뒤 실행.
###############################################################################
PATCH {{baseUrl}}/api/v1/members/me/password
Authorization: Bearer {{memberAccessToken}}
Content-Type: {{contentType}}

{
  "currentPassword": "{{memberPassword}}",
  "newPassword": "{{changedMemberPassword}}"
}


###############################################################################
# 64. 비밀번호 변경 후 재로그인
###############################################################################
POST {{baseUrl}}/api/v1/auth/sign-in
Content-Type: {{contentType}}

{
  "email": "{{changedMemberEmail}}",
  "password": "{{changedMemberPassword}}"
}

> {%
    client.global.set("memberAccessToken", response.body.data.accessToken);
%}


###############################################################################
# 65. Access Token 재발급
### 64번 로그인에서 발급된 Refresh Token 쿠키가 HTTP Client cookie jar에 있어야 함.
###############################################################################
POST {{baseUrl}}/api/v1/auth/reissue

> {%
    client.global.set("memberAccessToken", response.body.data.accessToken);
%}


