Content-Type: {{contentType}}

{
  "ticket": "{{socialSignupTicket}}",
  "phone": "{{socialPhone}}",
  "phoneVerificationToken": "{{socialPhoneVerificationToken}}",
  "roadAddress": "서울특별시 마포구 월드컵북로 1",
  "jibunAddress": "서울특별시 마포구",
  "detailAddress": "303동 303호",
  "zipCode": "03900",
  "latitude": 37.5663,
  "longitude": 126.9019
}

> {%
    client.global.set("socialAccessToken", response.body.data.accessToken);
%}
