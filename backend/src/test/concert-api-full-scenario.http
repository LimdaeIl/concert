### Concert API 전체 Happy-Path 시나리오
### IntelliJ HTTP Client 기준
###
### 원칙
### - 번호 순서대로 실행
### - {% %} 블록에서는 client.global.set(...)만 사용
### - client.test / client.assert / if 미사용
### - 이메일/휴대전화 인증번호, OAuth code/ticket, 관리자 계정은 외부 선행값 필요
###
### Swagger 기준 서버
@baseUrl = http://localhost:8080
@contentType = application/json

### 사전 준비값
### 실제 관리자 계정으로 변경
@adminEmail = test1@test.com
@adminPassword = test1234!

### 신규 일반회원용 값
@memberEmail = test2@test.com
@memberPassword = test1234!
@memberName = 시나리오회원
@memberPhone = 01090000001

### 회원 정보 변경용 값
@changedMemberEmail = scenario-user-changed-20260808@example.com
@changedMemberPassword = test1234!
@changedMemberPhone = 01090000002

### 인증번호는 실제 발송된 값으로 교체
@emailVerificationCode = 000000
@phoneVerificationCode = 000000
@changedEmailVerificationCode = 000000
@changedPhoneVerificationCode = 000000

### OAuth 외부 선행값
@oauthExchangeCode = REPLACE_WITH_OAUTH_EXCHANGE_CODE
@socialSignupTicket = REPLACE_WITH_SOCIAL_SIGNUP_TICKET
@socialPhone = 01090000003
@socialPhoneVerificationCode = 000000


###############################################################################
# 1. 관리자 로그인
###############################################################################
POST {{baseUrl}}/api/v1/auth/sign-in
Content-Type: {{contentType}}

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set("adminAccessToken", response.body.accessToken);
%}


###############################################################################
# 2. 공연장 생성
###############################################################################
POST {{baseUrl}}/api/v1/admin/venues
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "name": "시나리오 콘서트 아레나 20260808",
  "phone": "01012341237",
  "roadAddress": "서울특별시 송파구 올림픽로 424",
  "jibunAddress": "서울특별시 송파구 방이동 88",
  "detailAddress": "시나리오 전용 공연장",
  "zipCode": "05540",
  "latitude": 37.5206868,
  "longitude": 127.1151534
}

> {%
    client.global.set("venueId", response.body.venueId);
%}


###############################################################################
# 3. 공연장 정보 수정
###############################################################################
PATCH {{baseUrl}}/api/v1/admin/venues/{{venueId}}
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "name": "시나리오 콘서트 아레나 20260808 수정",
  "phone": "01012341237",
  "roadAddress": "서울특별시 송파구 올림픽로 424",
  "jibunAddress": "서울특별시 송파구 방이동 88",
  "detailAddress": "시나리오 전용 공연장 수정",
  "zipCode": "05540",
  "latitude": 37.5206868,
  "longitude": 127.1151534
}


###############################################################################
# 4. 공연장 상태 INACTIVE 변경
###############################################################################
PATCH {{baseUrl}}/api/v1/admin/venues/{{venueId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "status": "INACTIVE"
}


###############################################################################
# 5. 공연장 상태 ACTIVE 복구
###############################################################################
PATCH {{baseUrl}}/api/v1/admin/venues/{{venueId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "status": "ACTIVE"
}


