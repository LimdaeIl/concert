###############################################################################
# 14. 물리 좌석 4개 일괄 생성
###############################################################################
POST {{baseUrl}}/api/v1/admin/halls/{{venueHallId}}/seats/bulk
Authorization: Bearer {{adminAccessToken}}
Content-Type: {{contentType}}

{
  "seats": [
    {
      "sectionName": "A",
      "floor": 1,
      "rowName": "1",
      "seatNumber": "1",
      "seatType": "STANDARD"
    },
    {
      "sectionName": "A",
      "floor": 1,
      "rowName": "1",
      "seatNumber": "2",
      "seatType": "STANDARD"
    },
    {
      "sectionName": "A",
      "floor": 1,
      "rowName": "1",
      "seatNumber": "3",
      "seatType": "STANDARD"
    },
    {
      "sectionName": "A",
      "floor": 1,
      "rowName": "1",
      "seatNumber": "4",
      "seatType": "STANDARD"
    }
  ]
}

> {%
    client.global.set("seatId1", response.body.seats[0].seatId);
    client.global.set("seatId2", response.body.seats[1].seatId);
    client.global.set("seatId3", response.body.seats[2].seatId);
    client.global.set("seatId4", response.body.seats[3].seatId);
%}


