###############################################################################
# 49. 예약 1 결제 승인
### providerData는 실제 PG 또는 프로젝트의 테스트 결제 Provider 규격에 맞게 변경
###############################################################################
POST {{baseUrl}}/api/v1/payments/{{paymentId1}}/confirm
Authorization: Bearer {{memberAccessToken}}
Content-Type: {{contentType}}

{
  "amount": {{paymentAmount1}},
  "providerData": {
    "paymentKey": "TEST_PAYMENT_KEY_1",
    "orderId": "{{paymentNumber1}}"
  }
}


###############################################################################
# 50. 예약 1 결제 취소
###############################################################################
POST {{baseUrl}}/api/v1/payments/{{paymentId1}}/cancel
Authorization: Bearer {{memberAccessToken}}
Content-Type: {{contentType}}

{
  "reason": "HTTP 시나리오 사용자 결제 취소 테스트",
  "providerData": {
    "paymentKey": "TEST_PAYMENT_KEY_1",
    "orderId": "{{paymentNumber1}}"
  }
}


