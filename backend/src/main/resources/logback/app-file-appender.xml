<?xml version="1.0" encoding="UTF-8"?>

<included>
  <!-- ============================================================
       Application Log
       INFO / WARN / ERROR를 모두 기록한다.
       파일 예: concert-backend-20260811.log
       같은 날짜에 애플리케이션이 재시작되더라도 기존 파일 뒤에 계속 append된다.
       날짜가 변경되면: concert-backend-20260812.log 파일이 새로 생성된다.
       ============================================================ -->
  <appender name="INFO_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <append>true</append>
    <!-- INFO 이상 -->
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>INFO</level>
    </filter>
    <encoder>
      <pattern>${FILE_LOG_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
    <!--
         file을 별도로 지정하지 않는다.
         현재 active 파일 자체가:
         concert-backend-20260811.log
         형식이 되도록 한다.
    -->
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>
        ${LOG_PATH}/concert-backend-%d{yyyyMMdd,Asia/Seoul}.log
      </fileNamePattern>
      <!-- 최근 14일 보관 -->
      <maxHistory>14</maxHistory>
      <!-- 전체 Application Log 최대 용량 -->
      <totalSizeCap>2GB</totalSizeCap>
      <!-- 애플리케이션 시작 시 오래된 로그 정리 -->
      <cleanHistoryOnStart>true</cleanHistoryOnStart>
    </rollingPolicy>
  </appender>
</included>